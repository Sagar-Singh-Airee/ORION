# ─── ORION Environment Configuration ─────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ─── Data Paths ──────────────────────────────────────────────────────────────
# Root directory containing the competition DICOM data
DATA_DIR=/path/to/rsna-knee-2026

# Pre-processed tensor cache directory (speeds up training)
CACHE_DIR=/path/to/orion-cache

# Directory to save training runs, checkpoints, logs
RUNS_DIR=./runs

# Kaggle API credentials (for downloading data)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ─── Experiment Tracking ──────────────────────────────────────────────────────
# Weights & Biases
WANDB_API_KEY=your_wandb_api_key
WANDB_PROJECT=rsna-knee-2026
WANDB_ENTITY=your_wandb_entity_or_team

# ─── Hardware Configuration ───────────────────────────────────────────────────
# Number of GPUs to use (0 = CPU)
NUM_GPUS=1

# CUDA device index (for single-GPU)
CUDA_VISIBLE_DEVICES=0

# ─── Translation API (for multilingual reports) ───────────────────────────────
# Optional: Google Translate API key (for batch translation)
GOOGLE_TRANSLATE_API_KEY=

# Optional: DeepL API key (higher quality translation)
DEEPL_API_KEY=

# ─── Reproducibility ─────────────────────────────────────────────────────────
GLOBAL_SEED=42

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=rich  # rich | json | plain
